# Victoria General Cleaning.
# OFICIAIS: os quatro da paleta base, mais #001139 e #0098f4 observados em uso
# nos carrosseis. INK e PRIMARY vieram dai, nao de derivacao.
# DERIVADO: apenas NEUTRAL, que e o proprio #001139 clareado sobre branco.
NAME=Victoria General Cleaning
BASE=#FFFFFF
INK=#001139
NEUTRAL=#A6ACBA
PRIMARY=#0098F4
SECONDARY=#FEADFF
SIGNAL=#FF30C8
BASE_DESC=clean white
INK_DESC=very deep navy blue
NEUTRAL_DESC=soft blue-gray
PRIMARY_DESC=vivid azure blue
SECONDARY_DESC=soft pink
SIGNAL_DESC=hot magenta
